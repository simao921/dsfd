# Supabase: preencher localmente; service role apenas no servidor
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# API separada; vazio em localhost para usar o proxy Vite
VITE_API_ORIGIN=
VITE_UPLOAD_LIMIT_MB=15

CRON_SECRET=

# Desenvolvimento local em HTTP
API_PORT=4000
COOKIE_SECURE=false
