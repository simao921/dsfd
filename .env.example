# Supabase: preencher localmente; service role apenas no servidor
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# API separada; vazio em localhost para usar o proxy Vite
VITE_API_ORIGIN=
VITE_UPLOAD_LIMIT_MB=15

# Serviço compatível com o endpoint OpenAI /audio/transcriptions
SPEECH_API_URL=https://api.openai.com/v1
SPEECH_API_KEY=
SPEECH_MODEL=whisper-1

# Serviço compatível com /chat/completions
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Desenvolvimento local em HTTP
API_PORT=4000
COOKIE_SECURE=false
