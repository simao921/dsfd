{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "api/[...path].ts": {
      "runtime": "nodejs22.x",
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/cron/daily-worker-report-utc0", "schedule": "59 23 * * *" },
    { "path": "/api/cron/daily-worker-report-utc1", "schedule": "59 22 * * *" }
  ]
}
